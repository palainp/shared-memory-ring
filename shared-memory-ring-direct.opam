opam-version: "2.0"
maintainer:   "piertre.alain@tuta.io"
authors:      [ "Pierre Alain" ]
license:      "ISC"
homepage:     "https://github.com/mirage/shared-memory-ring"
bug-reports:  "https://github.com/mirage/shared-memory-ring/issues"
dev-repo:     "git+https://github.com/mirage/shared-memory-ring.git"
doc:          "https://mirage.github.io/shared-memory-ring/"

build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]

depends: [
  "ocaml" {>= "4.08.0"}
  "dune" {>= "1.0"}
  "shared-memory-ring" {= version}
]
synopsis: "Direct-style interface to shared memory rings"
description: """
The same job as shared-memory-ring-lwt, with a callback per request in place of
its promise, so that nothing here blocks and nothing here needs a scheduler.
"""
x-maintenance-intent: [ "(latest)" ]
